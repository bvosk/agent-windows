root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.{cs,csx}]
# Naming conventions
dotnet_naming_rule.public_members_must_be_capitalized.symbols = public_symbols
dotnet_naming_rule.public_members_must_be_capitalized.style = pascal_case_style
dotnet_naming_rule.public_members_must_be_capitalized.severity = error

dotnet_naming_rule.private_fields_must_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_must_be_camel_case.style = camel_case_underscore_style
dotnet_naming_rule.private_fields_must_be_camel_case.severity = error

dotnet_naming_symbols.public_symbols.applicable_kinds = property, method, field, event, delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public, internal, protected

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

dotnet_naming_rule.local_constants_should_be_camel_case.symbols = local_constants
dotnet_naming_rule.local_constants_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.local_constants_should_be_camel_case.severity = error

dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Code style
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
csharp_prefer_braces = true:error
csharp_style_expression_bodied_methods = when_on_single_line:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_accessors = true:error

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = none  # Avoid requiring XML documentation file generation for build-time unused-using analysis

# StyleCop - Disable rules that conflict with modern C# style
dotnet_diagnostic.SA1101.severity = none  # Don't require 'this.' prefix
dotnet_diagnostic.SA0001.severity = none  # XML comments optional
dotnet_diagnostic.SA1600.severity = none  # XML documentation is not required
dotnet_diagnostic.SA1601.severity = none  # XML documentation is not required
dotnet_diagnostic.CS1591.severity = none  # XML documentation is not required
dotnet_diagnostic.SA1309.severity = none  # Allow underscore prefix for private fields
dotnet_diagnostic.SA1122.severity = none  # Allow "" instead of string.Empty
dotnet_diagnostic.SA1512.severity = none  # Allow blank lines after single-line comments
dotnet_diagnostic.SA1515.severity = none  # Don't require blank lines before single-line comments

# StyleCop - Disable file header requirements
dotnet_diagnostic.SA1633.severity = none  # No file header required
dotnet_diagnostic.SA1634.severity = none  # No copyright tag required
dotnet_diagnostic.SA1635.severity = none  # No copyright text required
dotnet_diagnostic.SA1636.severity = none  # No copyright text matching required
dotnet_diagnostic.SA1637.severity = none  # No file name in header required
dotnet_diagnostic.SA1638.severity = none  # No file name matching required
dotnet_diagnostic.SA1640.severity = none  # No company text required
dotnet_diagnostic.SA1641.severity = none  # No company text matching required

# CSharpier - Disable formatting rules that conflict with CSharpier
dotnet_diagnostic.IDE0055.severity = none

# StyleCop - Formatting rules handled by CSharpier
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1001.severity = none
dotnet_diagnostic.SA1002.severity = none
dotnet_diagnostic.SA1003.severity = none
dotnet_diagnostic.SA1007.severity = none
dotnet_diagnostic.SA1008.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1010.severity = none
dotnet_diagnostic.SA1011.severity = none
dotnet_diagnostic.SA1012.severity = none
dotnet_diagnostic.SA1013.severity = none
dotnet_diagnostic.SA1014.severity = none
dotnet_diagnostic.SA1015.severity = none
dotnet_diagnostic.SA1016.severity = none
dotnet_diagnostic.SA1017.severity = none
dotnet_diagnostic.SA1018.severity = none
dotnet_diagnostic.SA1019.severity = none
dotnet_diagnostic.SA1020.severity = none
dotnet_diagnostic.SA1021.severity = none
dotnet_diagnostic.SA1022.severity = none
dotnet_diagnostic.SA1023.severity = none
dotnet_diagnostic.SA1024.severity = none
dotnet_diagnostic.SA1025.severity = none
dotnet_diagnostic.SA1026.severity = none
dotnet_diagnostic.SA1027.severity = none
dotnet_diagnostic.SA1028.severity = none
dotnet_diagnostic.SA1102.severity = none
dotnet_diagnostic.SA1103.severity = none
dotnet_diagnostic.SA1104.severity = none
dotnet_diagnostic.SA1105.severity = none
dotnet_diagnostic.SA1107.severity = none
dotnet_diagnostic.SA1110.severity = none
dotnet_diagnostic.SA1111.severity = none
dotnet_diagnostic.SA1112.severity = none
dotnet_diagnostic.SA1113.severity = none
dotnet_diagnostic.SA1114.severity = none
dotnet_diagnostic.SA1115.severity = none
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1118.severity = none
dotnet_diagnostic.SA1127.severity = none
dotnet_diagnostic.SA1128.severity = none
dotnet_diagnostic.SA1136.severity = none
dotnet_diagnostic.SA1137.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1500.severity = none
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1502.severity = none
dotnet_diagnostic.SA1504.severity = none
dotnet_diagnostic.SA1505.severity = none
dotnet_diagnostic.SA1506.severity = none
dotnet_diagnostic.SA1507.severity = none
dotnet_diagnostic.SA1508.severity = none
dotnet_diagnostic.SA1509.severity = none
dotnet_diagnostic.SA1510.severity = none
dotnet_diagnostic.SA1511.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1517.severity = none
dotnet_diagnostic.SA1518.severity = none

# Meziantou - Disable overly strict rules
dotnet_diagnostic.MA0003.severity = none  # Don't require named arguments for booleans

# Roslynator - keep rule severities centralized in EditorConfig
dotnet_diagnostic.RCS1021.severity = error
dotnet_diagnostic.RCS1036.severity = error
dotnet_diagnostic.RCS1037.severity = error
dotnet_diagnostic.RCS1090.severity = none
dotnet_diagnostic.RCS1194.severity = error

# SonarAnalyzer - Disable rules for top-level statements
dotnet_diagnostic.S1118.severity = none  # Program class doesn't need protected constructor

# SonarAnalyzer - Security rules
dotnet_diagnostic.S2068.severity = error
dotnet_diagnostic.S2092.severity = error
dotnet_diagnostic.S3330.severity = error
dotnet_diagnostic.S5122.severity = error
dotnet_diagnostic.S5131.severity = error

# SonarAnalyzer - Bug detection
dotnet_diagnostic.S1854.severity = error
dotnet_diagnostic.S2259.severity = error
dotnet_diagnostic.S3966.severity = error

# SonarAnalyzer - Code smells
dotnet_diagnostic.S1481.severity = error
dotnet_diagnostic.S1144.severity = error
dotnet_diagnostic.S125.severity = error

# Category-wide style enforcement
dotnet_analyzer_diagnostic.category-Style.severity = error

# CLI conventions - internal-by-default is not useful for a small tool surface
dotnet_diagnostic.CA1515.severity = none

# Console apps have no SynchronizationContext - do not require ConfigureAwait and ban it explicitly
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.RS0030.severity = error

# Prefer file-scoped namespaces (modern C# style)
dotnet_diagnostic.IDE0160.severity = none
csharp_style_namespace_declarations = file_scoped:error

# Ignore expression-value diagnostics for fluent assertion patterns
dotnet_diagnostic.IDE0058.severity = none

# Explicit accessibility modifiers required
dotnet_style_require_accessibility_modifiers = always:error

# Prefer readonly fields
dotnet_style_readonly_field = true:error

# Prefer simplified boolean expressions
dotnet_style_prefer_simplified_boolean_expressions = true:error

# Collection expressions (C# 12+)
dotnet_style_prefer_collection_expression = true:error

# Test project specific rules
[tests/**/*.cs]
# Allow underscores in test method names (standard convention: Method_Scenario_Expected)
dotnet_diagnostic.CA1707.severity = none
# Preserve the existing cancellation-token test style on xUnit v3.
dotnet_diagnostic.xUnit1051.severity = none

[*.{json,yml,yaml}]
indent_size = 2
