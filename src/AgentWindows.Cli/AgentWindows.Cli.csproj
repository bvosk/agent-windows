<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>AgentWindows.Cli</RootNamespace>
        <AssemblyName>agent-windows</AssemblyName>
        <Version>0.1.0</Version>
        <IsPackable>false</IsPackable>
        <!-- ReadyToRun benefits the win-x64 self-contained CLI. The framework-dependent
             dotnet-tool payload stays IL-only so its `any` package remains host-portable. -->
        <PublishReadyToRun Condition="'$(SelfContained)' == 'true'">true</PublishReadyToRun>
        <!-- Analyze APIs for compatibility with the self-contained single-file artifact. -->
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <!-- LibraryImport source generation (pipe probe) requires unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Agent-facing skill docs, served by 'agent-windows skills'. -->
        <EmbeddedResource
            Include="../../skill-data/**/*.md"
            LogicalName="skill-data/%(RecursiveDir)%(Filename)%(Extension)"
        />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
        <ProjectReference Include="../AgentWindows.Automation/AgentWindows.Automation.csproj" />
        <ProjectReference Include="../AgentWindows.Core/AgentWindows.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AgentWindows.Cli.Tests" />
    </ItemGroup>
</Project>
